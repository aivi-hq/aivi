{
  "name": "@aivi/github",
  "version": "0.0.0",
  "description": "The GitHub app aivi works as: the credential, the one installation, the API client, the git transport, the webhook check, and the worker signature. A plain library — the forge and the tracker share it; it registers nothing and owns no config block.",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=26.1.0 <27"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aivi-hq/aivi.git",
    "directory": "packages/github"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@aivi/core": "^0.7.1",
    "@aivi/plugin": "^0.1.0",
    "@octokit/auth-app": "8.3.1",
    "@octokit/core": "7.0.8",
    "@octokit/plugin-rest-endpoint-methods": "17.0.0",
    "@octokit/plugin-retry": "8.1.1"
  }
}
