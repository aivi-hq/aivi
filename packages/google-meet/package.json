{
  "name": "@aivi/google-meet",
  "version": "0.1.0",
  "private": false,
  "description": "aivi in a Google Meet: the aivi face as the camera, the waiting room clicked through, the call held until a human hangs up",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "development": "./src/config.ts",
      "default": "./dist/config.js"
    },
    "./setup": {
      "development": "./src/setup.ts",
      "default": "./dist/setup.js"
    },
    "./cli": {
      "development": "./src/cli.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26.1.0 <27"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aivi-hq/aivi.git",
    "directory": "packages/google-meet"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@aivi/chrome": "^1.0.0",
    "@aivi/core": "^1.0.0",
    "@aivi/plugin": "^1.0.0",
    "commander": "15.0.0",
    "zod": "4.1.13"
  },
  "peerDependencies": {
    "@aivi/host": "^1.0.0"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1"
  }
}
