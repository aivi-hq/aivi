{
  "$schema": "https://nodejs.org/dist/latest-v26.x/docs/node-config-schema.json",
  "test": {
    "experimental-test-module-mocks": true,
    "test-timeout": 5000,
    "test-coverage-include-all": true,
    "test-coverage-exclude": [
      "packages/*/dist/**",
      "packages/*/test/**",
      "scripts/**",
      "site/**",
      "dev/**",
      "packages/host/src/api/env.ts",
      "packages/plugin/src/channel.ts",
      "packages/plugin/src/dispatcher.ts",
      "packages/plugin/src/forge.ts",
      "packages/plugin/src/plugin.ts"
    ]
  }
}
