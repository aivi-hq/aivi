node_modules/
*.tsbuildinfo
.aivi/
*.sqlite*
.env
.env.*
!.env.example
*.tgz
.DS_Store
# The live aivi config is edited by aivi and its operator; only templates are tracked.
aivi.json

# The dev home is a real home, produced by `npm run aivi:cli setup`: config.json,
# .env, app/ (with the manifest setup writes and npm fills), state/ and the
# client config are all generated or local — only the README is tracked.
dev/*
!dev/README.md

# Build output: compiled packages (the published artifact; exports maps default
# to dist/) and their build info.
dist/

# Test coverage (npm run test:cov): the Istanbul json fallow scores CRAP from,
# plus c8's temporary V8 dumps.
coverage/

.fallow/
