node_modules/
*.tsbuildinfo
.aivi/
*.sqlite*
.env
.env.*
!.env.example
*.tgz
.DS_Store
# The live aivi config is edited by aivi and its operator; only templates are tracked.
aivi.json

# The dev home is a real home, produced by `npm run aivi:cli setup`: config.json,
# .env, the installed app/ and state/ are all generated or local — only the
# README and the app manifest that anchors npm inside dev/ are tracked.
dev/*
!dev/README.md
!dev/app
dev/app/*
!dev/app/package.json

# Build output: compiled packages (every exports map points at dist/) and
# their build info.
dist/
