{
  "$schema": "../schemas/aivi.schema.json",
  "version": 1,
  "host": {
    "port": 4100
  },
  "opencode": {
    "lifecycle": "discover"
  },
  "knowledge": [
    {
      "id": "company",
      "path": "knowledge"
    }
  ],
  "scheduler": {
    "maxConcurrent": 1,
    "resources": {
      "local-model": 1,
      "maintenance": 1
    },
    "misfire": {
      "graceSeconds": 60
    },
    "retention": {
      "cron": "0 4 * * *",
      "timezone": "UTC",
      "olderThanDays": 30,
      "resource": "maintenance"
    },
    "projectsSync": {
      "cron": "30 * * * *",
      "timezone": "UTC",
      "resource": "maintenance"
    }
  },
  "jobs": [
    {
      "id": "check-sources",
      "cron": "*/5 * * * *",
      "timezone": "UTC",
      "resource": "maintenance",
      "task": {
        "kind": "invocation",
        "name": "system.check"
      }
    },
    {
      "id": "refresh-knowledge",
      "cron": "0 * * * *",
      "timezone": "UTC",
      "resource": "maintenance",
      "task": {
        "kind": "invocation",
        "name": "knowledge.index"
      }
    },
    {
      "id": "dreaming",
      "cron": "0 3 * * *",
      "timezone": "Europe/Amsterdam",
      "resource": "local-model",
      "task": {
        "kind": "invocation",
        "name": "dreaming",
        "args": {
          "origins": ["discord", "slack"]
        }
      },
      "report": {
        "to": "channel",
        "module": "discord",
        "channel": "10000000000000005",
        "on": "always"
      }
    }
  ],
  "search": {
    "provider": "qmd",
    "indexOnStart": true
  },
  "modules": {
    "discord": {
      "applicationId": "10000000000000001",
      "agent": "librarian",
      "access": {
        "dm": {
          "users": ["10000000000000002"]
        },
        "channels": [
          {
            "id": "10000000000000004",
            "users": "anyone"
          }
        ]
      },
      "reportChannels": ["10000000000000005"],
      "messageContent": true,
      "progress": "status",
      "resource": "local-model",
      "maxConcurrent": 1,
      "maxPending": 100,
      "turnTimeoutMs": 300000
    },
    "slack": {
      "agent": "librarian",
      "commandPrefix": "aivi",
      "access": {
        "dm": {
          "users": ["U0000000001"]
        },
        "channels": [
          {
            "id": "C0000000001",
            "users": "anyone"
          }
        ]
      },
      "reportChannels": ["C0000000001"],
      "progress": "status",
      "resource": "local-model",
      "maxConcurrent": 1,
      "maxPending": 100,
      "turnTimeoutMs": 300000
    }
  }
}
