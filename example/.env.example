# Copy to .env (git-ignored). Loaded without overriding variables already set.
# Third-party secrets only: aivi's own API takes no token.
DISCORD_BOT_TOKEN=replace-with-your-bot-token
SLACK_BOT_TOKEN=xoxb-replace-with-your-bot-token
SLACK_APP_TOKEN=xapp-replace-with-your-app-level-token
# Linear: the one app keeps the bare names — it carries the data feed and
# authorises the Linear MCP proxy (docs/linear.md).
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# LINEAR_WEBHOOK_SECRET=
# Extra apps ("faces": a name and icon in Linear's UI, no routing meaning);
# <APP> is the app id upper-cased, - as _.
# LINEAR_<APP>_CLIENT_ID=
# LINEAR_<APP>_CLIENT_SECRET=
# LINEAR_<APP>_WEBHOOK_SECRET=
