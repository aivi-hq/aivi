{
  "$schema": "../schemas/aivi.schema.json",
  "version": 1,
  "host": {
    "port": 4100
  },
  "opencode": {
    "lifecycle": "discover"
  },
  "knowledge": [
    {
      "id": "company",
      "path": "knowledge"
    },
    {
      "id": "memory",
      "path": "memory",
      "kind": "memory"
    }
  ],
  "projects": [
    {
      "id": "demo",
      "directory": "project"
    }
  ],
  "scheduler": {
    "maxConcurrent": 1,
    "resources": {
      "local-model": 1,
      "maintenance": 1
    }
  },
  "schedules": [
    {
      "id": "check-sources",
      "cron": "*/5 * * * *",
      "timezone": "UTC",
      "resource": "maintenance",
      "task": {
        "kind": "system.check"
      }
    },
    {
      "id": "refresh-knowledge",
      "cron": "0 * * * *",
      "timezone": "UTC",
      "resource": "maintenance",
      "task": {
        "kind": "knowledge.index"
      }
    },
    {
      "id": "dreaming",
      "cron": "0 3 * * *",
      "timezone": "Europe/Amsterdam",
      "resource": "local-model",
      "task": {
        "kind": "dreaming",
        "memoryDirectory": "memory",
        "origins": ["discord"]
      },
      "report": {
        "to": "channel",
        "module": "discord",
        "channel": "10000000000000005",
        "on": "always"
      }
    }
  ],
  "search": {
    "provider": "qmd",
    "indexOnStart": true
  },
  "modules": {
    "discord": {
      "config": "discord.json"
    }
  }
}
