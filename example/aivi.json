{
  "$schema": "../schemas/aivi.schema.json",
  "version": 1,
  "host": {
    "port": 4100
  },
  "opencode": {
    "lifecycle": "discover"
  },
  "knowledge": [
    {
      "id": "company",
      "path": "knowledge"
    }
  ],
  "scheduler": {
    "maxConcurrent": 1,
    "resources": {
      "local-model": 1,
      "maintenance": 1
    },
    "misfire": { "graceSeconds": 60 },
    "retention": {
      "cron": "0 4 * * *",
      "timezone": "UTC",
      "olderThanDays": 30,
      "resource": "maintenance"
    }
  },
  "jobs": [
    {
      "id": "check-sources",
      "cron": "*/5 * * * *",
      "timezone": "UTC",
      "resource": "maintenance",
      "task": {
        "kind": "system.check"
      }
    },
    {
      "id": "refresh-knowledge",
      "cron": "0 * * * *",
      "timezone": "UTC",
      "resource": "maintenance",
      "task": {
        "kind": "knowledge.index"
      }
    },
    {
      "id": "dreaming",
      "cron": "0 3 * * *",
      "timezone": "Europe/Amsterdam",
      "resource": "local-model",
      "task": {
        "kind": "dreaming",
        "origins": ["discord", "slack"]
      },
      "report": { "to": "channel", "module": "discord", "channel": "10000000000000005", "on": "always" }
    }
  ],
  "search": {
    "provider": "qmd",
    "indexOnStart": true
  },
  "modules": {
    "discord": {
      "config": "discord.json"
    },
    "slack": {
      "config": "slack.json"
    }
  }
}
