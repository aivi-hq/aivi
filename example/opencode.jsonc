{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "librarian",
  "plugins": [
    {
      "package": "../packages/opencode/dist/index.js",
      "options": { "url": "http://127.0.0.1:4100" }
    }
  ],
  "mcp": {
    // Linear's hosted MCP through aivi's own loopback forwarder: enable
    // `linear.mcp` in aivi.json (default port 4101) and point here. Writes
    // attribute to the app, never a human.
    "linear": {
      "type": "remote",
      "url": "http://127.0.0.1:4101/mcp"
    }
  }
}
