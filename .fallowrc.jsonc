{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}"
  ],
  "dynamicallyLoaded": [
    // The CLI's one edge into the installed server: importApp() imports these
    // host modules by string path (`dist/cli/*.js`) — `aivi remove` drops
    // a plugin's config block, setup/add/remove/update rebuild the editor
    // schema, and setup asks the models question through warmHome. Nothing
    // imports them statically, by design.
    "packages/host/src/cli/plugin-remove.ts",
    "packages/host/src/cli/schema-cache.ts",
    "packages/host/src/cli/commands/knowledge.ts"
  ],
  // dev/ is the generated development home (an installed app, its own
  // package.json, worktrees) — not this repo's source. scripts/ is dev
  // tooling run against the tree (ruled 2026-10-20): its use of the root's
  // devDependencies is not worth analyzing, and the checks that gate the
  // product (smoke) reach the tree through spawned paths, not imports.
  "ignorePatterns": [
    "dev/**",
    "scripts/**"
  ],
  // @discordjs/voice requires its sodium implementation at runtime; the
  // declaration is what supplies it, and no import in our sources names it.
  "ignoreDependencies": [
    "libsodium-wrappers"
  ],
  "workspaces": {
    "patterns": [
      "packages/*"
    ]
  },
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3
    // Common additions (uncomment to enable):
    // "ignore": [
    //   "**/lib/**",          // for repos that publish transpiled output to lib/
    //   "**/legacy/**",       // for repos with legacy-build artifacts
    //   "**/__generated__/**", // Relay, GraphQL Code Generator
    //   "**/generated/**"     // OpenAPI, Protobuf codegen
    // ]
  },
  "typeAware": { "enabled": true },
  "publicPackages": [
    // @aivi/chrome ships its API to outside consumers (ruled 2026-10-20):
    // used internally, published so people can drive a browser on their
    // own. The published surface is the product, so fallow does not read
    // it as unused here.
    "@aivi/chrome"
  ],
  "health": {
    // Istanbul coverage from `npm run test:cov`, so CRAP scores are measured, not estimated.
    "coverage": "./coverage/coverage-final.json",
    // 30 → 350 for now. c8 drops nameless inline callbacks from its function
    // map, so fallow estimates CRAP = cc²+cc for code that ran; the round's
    // 114 complexity findings are all fixed and the 77 estimates left are
    // all of that kind. Complexity thresholds stay at their defaults — those
    // are the real gate. Swap the coverage producer for one that records
    // anonymous functions (vitest does) and this can drop back to 30.
    "maxCrap": 350
  },
  "rules": {}
}
