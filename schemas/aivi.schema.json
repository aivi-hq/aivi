{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Editor hint; ignored at runtime.",
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "stateDirectory": {
      "default": "state",
      "type": "string"
    },
    "host": {
      "default": {
        "bind": "127.0.0.1",
        "port": 4100,
        "auth": {
          "mode": "token"
        }
      },
      "type": "object",
      "properties": {
        "bind": {
          "default": "127.0.0.1",
          "type": "string",
          "minLength": 1
        },
        "port": {
          "default": 4100,
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "auth": {
          "default": {
            "mode": "token"
          },
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "token"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "none"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "opencode": {
      "default": {
        "lifecycle": "own"
      },
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "lifecycle": {
          "description": "discover: never start or stop the local service. ensure: start one when none runs. own (default): also restart a running one at `aivi serve` startup (persistent terminals are handed off), so aivi is the one thing to supervise.",
          "default": "own",
          "type": "string",
          "enum": [
            "discover",
            "ensure",
            "own"
          ]
        }
      },
      "additionalProperties": false
    },
    "knowledge": {
      "description": "Core sources; `<home>/memory` is added as the core `memory` source automatically.",
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "description": "doc: Reference material: handbooks, guides, research notes. Relevant whenever the topic matches. decision: Recorded decisions (ADRs). Authoritative for why something is the way it is; cite them over inference. memory: Facts and proposals distilled from conversations by dreaming. Dated and attributed; softer than docs and decisions. conversation: Indexed conversation transcripts. Useful for recovering details; never authoritative.",
            "default": "doc",
            "type": "string",
            "enum": [
              "doc",
              "decision",
              "memory",
              "conversation"
            ]
          }
        },
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "projectDefaults": {
      "description": "The company-wide repository convention. Default: docs/ as doc, docs/adr as decision.",
      "default": {
        "knowledge": [
          {
            "id": "docs",
            "path": "docs",
            "kind": "doc"
          },
          {
            "id": "adr",
            "path": "docs/adr",
            "kind": "decision"
          }
        ]
      },
      "type": "object",
      "properties": {
        "knowledge": {
          "description": "Sources every project gets unless it lists its own; paths relative to the checkout.",
          "default": [
            {
              "id": "docs",
              "path": "docs",
              "kind": "doc"
            },
            {
              "id": "adr",
              "path": "docs/adr",
              "kind": "decision"
            }
          ],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "description": "doc: Reference material: handbooks, guides, research notes. Relevant whenever the topic matches. decision: Recorded decisions (ADRs). Authoritative for why something is the way it is; cite them over inference. memory: Facts and proposals distilled from conversations by dreaming. Dated and attributed; softer than docs and decisions. conversation: Indexed conversation transcripts. Useful for recovering details; never authoritative.",
                "default": "doc",
                "type": "string",
                "enum": [
                  "doc",
                  "decision",
                  "memory",
                  "conversation"
                ]
              }
            },
            "required": [
              "id",
              "path"
            ],
            "additionalProperties": false
          }
        },
        "linear": {
          "description": "The lane convention for projects that do not map the lane themselves.",
          "type": "object",
          "properties": {
            "lanes": {
              "description": "The lane convention every Linear project gets unless it maps the lane itself: workflow state name → app id, or null for a lane humans work.",
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "workspaceId": {
              "description": "Linear organization id every project gets unless it names its own.",
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "projects": {
      "description": "Overrides per project id. Projects are discovered as the directories of <home>/projects; each gets <home>/memory/<id> as its memory source.",
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "description": "false: the checkout stays but aivi ignores it.",
            "default": true,
            "type": "boolean"
          },
          "knowledge": {
            "description": "Replaces projectDefaults.knowledge for this project; paths relative to the checkout.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "description": "doc: Reference material: handbooks, guides, research notes. Relevant whenever the topic matches. decision: Recorded decisions (ADRs). Authoritative for why something is the way it is; cite them over inference. memory: Facts and proposals distilled from conversations by dreaming. Dated and attributed; softer than docs and decisions. conversation: Indexed conversation transcripts. Useful for recovering details; never authoritative.",
                  "default": "doc",
                  "type": "string",
                  "enum": [
                    "doc",
                    "decision",
                    "memory",
                    "conversation"
                  ]
                }
              },
              "required": [
                "id",
                "path"
              ],
              "additionalProperties": false
            }
          },
          "linear": {
            "type": "object",
            "properties": {
              "workspaceId": {
                "description": "Linear organization id; only needed with more than one workspace.",
                "type": "string",
                "minLength": 1
              },
              "teams": {
                "description": "Linear team ids whose issues belong to this project; a team maps to at most one project.",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "lanes": {
                "description": "Workflow state name → app id: issues entering that state are worked by that app. `null` marks a human lane: the gateway never runs on it, and it overrides a projectDefaults lane. Empty by default: the listener delegates nothing until you map a lane.",
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]*$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "required": [
              "teams"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "modules": {
      "default": {},
      "type": "object",
      "properties": {
        "discord": {
          "description": "Presence of this block enables the Discord module; `false` is an explicit off.",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "applicationId": {
                  "description": "The Discord application the bot token belongs to.",
                  "type": "string",
                  "pattern": "^\\d{17,20}$"
                },
                "agent": {
                  "default": "librarian",
                  "type": "string"
                },
                "directory": {
                  "default": ".",
                  "type": "string",
                  "minLength": 1
                },
                "resource": {
                  "default": "local-model",
                  "type": "string"
                },
                "access": {
                  "description": "Who may talk to aivi through this channel. Unmatched messages are ignored before anything is stored or sent to a model.",
                  "type": "object",
                  "properties": {
                    "dm": {
                      "description": "Private messages. Omit to refuse all DMs.",
                      "type": "object",
                      "properties": {
                        "users": {
                          "description": "User IDs allowed to talk to aivi in private messages.",
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "users"
                      ],
                      "additionalProperties": false
                    },
                    "channels": {
                      "description": "Shared places aivi listens in, each with its own rules.",
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "description": "Channel ID as the platform reports it.",
                            "type": "string",
                            "minLength": 1
                          },
                          "users": {
                            "description": "\"anyone\", or the user IDs aivi listens to here.",
                            "default": "anyone",
                            "anyOf": [
                              {
                                "type": "string",
                                "const": "anyone"
                              },
                              {
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              }
                            ]
                          },
                          "trigger": {
                            "description": "\"mention\": every message must address aivi. \"mention-to-start\": a mention opens a conversation; inside a thread aivi already takes part in, every message counts. \"any\": every message counts (needs message content access).",
                            "default": "mention-to-start",
                            "type": "string",
                            "enum": [
                              "mention",
                              "mention-to-start",
                              "any"
                            ]
                          },
                          "sessions": {
                            "description": "\"threads\": a top-level message addressing aivi opens a thread; each thread is its own conversation and the channel itself never is. \"channel\": the channel is one shared conversation and its threads are ignored.",
                            "default": "threads",
                            "type": "string",
                            "enum": [
                              "threads",
                              "channel"
                            ]
                          }
                        },
                        "required": [
                          "id"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "reportChannels": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^\\d{17,20}$"
                  }
                },
                "messageContent": {
                  "default": false,
                  "type": "boolean"
                },
                "progress": {
                  "default": "status",
                  "type": "string",
                  "enum": [
                    "silent",
                    "status",
                    "tools"
                  ]
                },
                "maxConcurrent": {
                  "default": 1,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                },
                "maxPending": {
                  "default": 100,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "turnTimeoutMs": {
                  "default": 300000,
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 3600000
                }
              },
              "required": [
                "applicationId",
                "access"
              ],
              "additionalProperties": false
            },
            {
              "type": "boolean",
              "const": false
            }
          ]
        },
        "slack": {
          "description": "Presence of this block enables the Slack module; `false` is an explicit off.",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "agent": {
                  "default": "librarian",
                  "type": "string"
                },
                "directory": {
                  "default": ".",
                  "type": "string",
                  "minLength": 1
                },
                "commandPrefix": {
                  "default": "aivi",
                  "type": "string",
                  "maxLength": 24,
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "resource": {
                  "default": "local-model",
                  "type": "string"
                },
                "access": {
                  "description": "Who may talk to aivi through this channel. Unmatched messages are ignored before anything is stored or sent to a model.",
                  "type": "object",
                  "properties": {
                    "dm": {
                      "description": "Private messages. Omit to refuse all DMs.",
                      "type": "object",
                      "properties": {
                        "users": {
                          "description": "User IDs allowed to talk to aivi in private messages.",
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "users"
                      ],
                      "additionalProperties": false
                    },
                    "channels": {
                      "description": "Shared places aivi listens in, each with its own rules.",
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "description": "Channel ID as the platform reports it.",
                            "type": "string",
                            "minLength": 1
                          },
                          "users": {
                            "description": "\"anyone\", or the user IDs aivi listens to here.",
                            "default": "anyone",
                            "anyOf": [
                              {
                                "type": "string",
                                "const": "anyone"
                              },
                              {
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              }
                            ]
                          },
                          "trigger": {
                            "description": "\"mention\": every message must address aivi. \"mention-to-start\": a mention opens a conversation; inside a thread aivi already takes part in, every message counts. \"any\": every message counts (needs message content access).",
                            "default": "mention-to-start",
                            "type": "string",
                            "enum": [
                              "mention",
                              "mention-to-start",
                              "any"
                            ]
                          },
                          "sessions": {
                            "description": "\"threads\": a top-level message addressing aivi opens a thread; each thread is its own conversation and the channel itself never is. \"channel\": the channel is one shared conversation and its threads are ignored.",
                            "default": "threads",
                            "type": "string",
                            "enum": [
                              "threads",
                              "channel"
                            ]
                          }
                        },
                        "required": [
                          "id"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "reportChannels": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "progress": {
                  "default": "status",
                  "type": "string",
                  "enum": [
                    "silent",
                    "status",
                    "tools"
                  ]
                },
                "maxConcurrent": {
                  "default": 1,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                },
                "maxPending": {
                  "default": 100,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "turnTimeoutMs": {
                  "default": 300000,
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 3600000
                }
              },
              "required": [
                "access"
              ],
              "additionalProperties": false
            },
            {
              "type": "boolean",
              "const": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "browser": {
      "description": "Chrome for browser_control. Default: aivi launches its own Chrome with a profile under state/chrome on first use. `false` disables the browser service.",
      "default": {
        "connection": {
          "mode": "launch",
          "userDataDir": "state/chrome"
        }
      },
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "connection": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "const": "launch"
                    },
                    "userDataDir": {
                      "type": "string",
                      "minLength": 1
                    },
                    "executablePath": {
                      "type": "string",
                      "minLength": 1
                    },
                    "headless": {
                      "default": false,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "mode",
                    "userDataDir"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "const": "existing"
                    },
                    "userDataDir": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "mode",
                    "userDataDir"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "const": "attach"
                    },
                    "browserUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "mode",
                    "browserUrl"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "maxTabsPerSession": {
              "default": 5,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "maxTabs": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "maxPending": {
              "default": 16,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "timeoutMs": {
              "default": 30000,
              "type": "integer",
              "minimum": 1000,
              "maximum": 60000
            }
          },
          "required": [
            "connection"
          ],
          "additionalProperties": false
        },
        {
          "type": "boolean",
          "const": false
        }
      ]
    },
    "search": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "const": "qmd"
        },
        "indexOnStart": {
          "default": true,
          "type": "boolean"
        },
        "maxPending": {
          "default": 32,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    },
    "linear": {
      "type": "object",
      "properties": {
        "apps": {
          "description": "Linear apps by id; lanes in projects.<id>.linear.lanes refer to these ids.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "agent": {
                "description": "The OpenCode agent this app runs as; unique across apps.",
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "agent"
            ],
            "additionalProperties": false
          }
        },
        "logMisroutes": {
          "description": "Log at warn a webhook delivered to the wrong endpoint (a data change on an app route, an agent session on the data route); it is dropped either way.",
          "default": true,
          "type": "boolean"
        },
        "listener": {
          "description": "React to issue lane changes by delegating eligible issues to the lane’s app. Off: only delegations and mentions made in Linear start a worker.",
          "default": false,
          "type": "boolean"
        },
        "humanLabel": {
          "description": "Issues carrying this label are never worked automatically; a hand delegation is refused with an explanation.",
          "default": "needs-human",
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "description": "Pool a worker turn takes a slot in.",
          "default": "local-model",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "progress": {
          "description": "What the ephemeral activities in the agent session show while a worker runs.",
          "default": "tools",
          "type": "string",
          "enum": [
            "silent",
            "status",
            "tools"
          ]
        },
        "turnTimeoutMs": {
          "description": "A worker turn longer than this is interrupted and ends stopped.",
          "default": 7200000,
          "type": "integer",
          "minimum": 60000,
          "maximum": 86400000
        }
      },
      "required": [
        "apps"
      ],
      "additionalProperties": false
    },
    "scheduler": {
      "default": {
        "maxConcurrent": 1,
        "resources": {
          "local-model": 1
        },
        "agentSchedules": {
          "resource": "local-model",
          "max": 50
        },
        "misfire": {
          "graceSeconds": 60
        },
        "retention": {
          "cron": "0 4 * * *",
          "olderThanDays": 30
        },
        "projectsSync": {
          "cron": "0 * * * *"
        }
      },
      "type": "object",
      "properties": {
        "maxConcurrent": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "resources": {
          "default": {
            "local-model": 1
          },
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          }
        },
        "agentSchedules": {
          "description": "OpenCode agents create jobs through the aivi_jobs tool; whoever may talk to an agent may schedule. `false` disables the tool.",
          "default": {
            "resource": "local-model",
            "max": 50
          },
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "resource": {
                  "description": "Pool that agent-created jobs run in.",
                  "default": "local-model",
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*$"
                },
                "max": {
                  "description": "How many agent-created jobs (recurring, or one-offs not yet fired) may exist at once.",
                  "default": 50,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 500
                }
              },
              "additionalProperties": false
            },
            {
              "type": "boolean",
              "const": false
            }
          ]
        },
        "misfire": {
          "description": "Default for every job: an occurrence found more than graceSeconds late (aivi was down) becomes one missed run per job, never executed.",
          "default": {
            "graceSeconds": 60
          },
          "type": "object",
          "properties": {
            "graceSeconds": {
              "default": 60,
              "description": "An occurrence found later than this after downtime is recorded as a missed run, never executed. A large value means \"run whenever\".",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "retention": {
          "description": "The system job `retention` (task runs.prune) that deletes finished runs and finished one-off jobs older than olderThanDays. `false` removes it.",
          "default": {
            "cron": "0 4 * * *",
            "olderThanDays": 30
          },
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "cron": {
                  "default": "0 4 * * *",
                  "type": "string",
