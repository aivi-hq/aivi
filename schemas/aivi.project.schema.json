{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Editor hint; ignored at runtime.",
      "type": "string"
    },
    "knowledge": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "description": "doc: Reference material: handbooks, guides, research notes. Relevant whenever the topic matches. decision: Recorded decisions (ADRs). Authoritative for why something is the way it is; cite them over inference. memory: Facts and proposals distilled from conversations by dreaming. Dated and attributed; softer than docs and decisions. conversation: Indexed conversation transcripts. Useful for recovering details; never authoritative.",
            "default": "doc",
            "type": "string",
            "enum": [
              "doc",
              "decision",
              "memory",
              "conversation"
            ]
          }
        },
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "linear": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "lanes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        }
      },
      "required": [
        "workspaceId",
        "projectId",
        "lanes"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
