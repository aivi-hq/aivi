{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Editor hint; ignored at runtime.",
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "applicationId": {
      "type": "string",
      "pattern": "^\\d{17,20}$"
    },
    "agent": {
      "default": "librarian",
      "type": "string"
    },
    "directory": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "default": "local-model",
      "type": "string"
    },
    "access": {
      "description": "Who may talk to aivi through this channel. Unmatched messages are ignored before anything is stored or sent to a model.",
      "type": "object",
      "properties": {
        "dm": {
          "description": "Private messages. Omit to refuse all DMs.",
          "type": "object",
          "properties": {
            "users": {
              "description": "User IDs allowed to talk to aivi in private messages.",
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "users"
          ],
          "additionalProperties": false
        },
        "channels": {
          "description": "Shared places aivi listens in, each with its own rules.",
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "description": "Channel ID as the platform reports it.",
                "type": "string",
                "minLength": 1
              },
              "users": {
                "description": "\"anyone\", or the user IDs aivi listens to here.",
                "default": "anyone",
                "anyOf": [
                  {
                    "type": "string",
                    "const": "anyone"
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "trigger": {
                "description": "\"mention\": every message must address aivi. \"mention-to-start\": a mention opens a conversation; inside a thread aivi already takes part in, every message counts. \"any\": every message counts (needs message content access).",
                "default": "mention-to-start",
                "type": "string",
                "enum": [
                  "mention",
                  "mention-to-start",
                  "any"
                ]
              },
              "sessions": {
                "description": "\"threads\": a top-level message addressing aivi opens a thread; each thread is its own conversation and the channel itself never is. \"channel\": the channel is one shared conversation and its threads are ignored.",
                "default": "threads",
                "type": "string",
                "enum": [
                  "threads",
                  "channel"
                ]
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "reportChannels": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{17,20}$"
      }
    },
    "messageContent": {
      "default": false,
      "type": "boolean"
    },
    "maxConcurrent": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "maxPending": {
      "default": 100,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "turnTimeoutMs": {
      "default": 300000,
      "type": "integer",
      "minimum": 1000,
      "maximum": 3600000
    }
  },
  "required": [
    "version",
    "applicationId",
    "directory",
    "access"
  ],
  "additionalProperties": false
}
